<aura:component implements="force:hasRecordId,force:lightningQuickActionWithoutHeader" controller="SyncTemplateControlleer" access="global">
    
    <aura:attribute name="isLoading" type="Boolean" default="true" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />

    <!-- Spinner -->
    <div style="max-height: 100px; position: relative; margin-top:100px;">
                    Please Wait for moment

        <aura:if isTrue="{!v.isLoading}">
            <lightning:spinner alternativeText="Loading..." size="medium" class="custom-spinner" />
        </aura:if>
    </div>
</aura:component>